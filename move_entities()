-- tab 2: move entities, check collision

function move_entities()

    player.celx = flr((player.scrxpos+4+player.momentx)/8)
    player.cely = flr((player.scrypos+player.momenty)/8)
    

    if player.state == 2 then -- checks if player in jump state, drops if so
        player.momenty += 0.3
        player.scrypos += player.momenty
    else
        player.momenty = 0
        player.scrypos = 8*player.cely
    end
    
    if (player.momenty > 4.0) player.momenty = 4.0
    if (abs(player.momentx) > 2) player.momentx = 2*player.facing
    player.scrxpos += player.momentx

end

function check_collision()

    if fget(mget(player.celx, player.cely-1), 0) then -- Player 'bangs head'
		player.momenty = 0
        player.scrypos = (8*player.cely)
	end

    if ((not fget(mget(player.celx, player.cely+2), 0)) and (not player.state == 3)) player.state = 2
        -- If player has nothing underneath them, and they're not mantling, state = jump(/fall)

    for hi = 0,1 do -- Loop through two for player height, checks if player hits obstruction horizontally

        if fget(mget(player.celx+player.facing, player.cely+hi), 0) then

		    player.momentx = 0
            player.scrxpos = 8*player.celx
	    end

    end

end

