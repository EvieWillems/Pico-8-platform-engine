-- Tab 2: Move entities

function move_entities()

    player.celx = flr((player.scrxpos+player.momentx)/8)
    player.cely = flr((player.scrypos+player.momenty)/8)
    

    if not fget(mget(player.celx, player.cely+2), 0) then
        player.momenty += 0.3
        player.scrypos += player.momenty
    else
        player.momenty = 0
        player.scrypos = 8*ceil(player.scrypos/8)
    end
    
    if (player.momenty > 4.0) player.momenty = 4.2
    

end





