function _init()

	player = {scrxpos=56, scrypos=48, mapxpos=0, mapypos=0, celx=0, cely=0, momentx=0, momenty=0, state=0, frame=2, animcount=1, animswitch = 1, health=1, facing = 1}

	-- notes: mapxpos and ypos track which screen player is on
	-- facing = -1 if left, 1 if right, to simplify momentum code
	-- states: 0 = idle, 1 = moving (accelerating), 2 = jumping/falling,
	-- 3 = mantling, 4 = dead, 5 = injured
	devtracker = 0
end




function _update()
	
	move_entities()
	check_player_state()

	
	
	

end




function _draw()

	cls()

	if player.facing == 1 then
		spr((player.state*3)+player.frame, player.scrxpos, player.scrypos)
		spr((player.state*3)+player.frame+16, player.scrxpos, player.scrypos+8)
	else
		spr((player.state*3)+player.frame, player.scrxpos, player.scrypos, 1, 1, true)
		spr((player.state*3)+player.frame+16, player.scrxpos, player.scrypos+8, 1, 1, true)
	end

	map(0, 0, 0, 0, 128, 128, 0)
	--x origin on map, y orig on map, xpos on screen, ypos on screen, x height, y height, flag
	rect(player.celx*8, player.cely*8,(player.celx*8)+8,(player.cely*8)+16)
	print(player.state)
	print(devtracker, 0, 8)

end