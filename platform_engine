-- :::NB: load platform_engine.p8  :::

function _init()

	player = {scrxpos=60, scrypos=60, mapxpos=60, mapypos=60, celx=6, cely=6, momentx=0, momenty=0, state=0, frame=1, animcount=1, health=1, facingleft = False}


end




function _update()

	move_entities()

	check_player_state()

end




function _draw()

	cls()

	if player.facingleft == False then
		spr((player.state*4)+player.frame, player.scrxpos, player.scrypos)
		spr((player.state*4)+player.frame+16, player.scrxpos, player.scrypos+8)
	else
		spr((player.state*4)+player.frame, player.scrxpos, player.scrypos, 1, 1, True)
		spr((player.state*4)+player.frame+16, player.scrxpos, player.scrypos+8, 1, 1, True)
	end

	map(0, 0, 0, 0, 128, 128, 0)	--x origin on map, y orig on map, xpos on screen, ypos on screen, x height, y height, flag

end