
-- tab 1: check player state



function check_player_state()   

	if player.state == 0 then  --0 = idle
		player_idle()
	elseif player.state == 1 then	-- 1 = moving
		player_move()
	elseif player.state == 2 then	-- 2 = jumping
		player_jump()
	elseif player.state == 3 then	-- 3 = mantling
		player_mantle()
--	elseif player.state == 4 then	-- 4 = dead
--		player_dead()
--	elseif player.state == 5 then	-- 5 = injured
--		player_injured()
	end

end

function reset_state(object, new_state)

	object.animcount = 0
	object.frame = 2
	object.animswitch = 1
	object.state = new_state

end

function player_idle()

	player.momentx = 0
	player.momenty = 0

	if player.animcount < 3 then	-- checks ticks elapsed for frame
		player.animcount += 1

	else

		player.animcount = 0

		if player.frame == 2 then	-- oscillates back and forth over 2, between 1 and 3 inclusive
			player.frame += player.animswitch
		else
			player.animswitch = player.animswitch * -1
			player.frame += player.animswitch
		end

	end


	
	if btnp(2) then				-- Checks input to leave state
		player.cely -= 1		-- Change cely to check collision
		player.momenty = -3.3		-- Change momentum to check collision
		if (check_collision(player, 'y')%2) == 1 then		-- If player collides, set back to idle (before changing frames), and reset momenty
			player.state = 0
			player.momenty = 0
		else
			reset_state(player, 2)		-- Else: Player has headroom, change state to jumping
		end								-- NB: This all needs doing out of order to avoid drawing while in state 2
	elseif btn(0) then
		player.facing = -1
		reset_state(player, 1)
		player_move()
	elseif btn(1) then
		player.facing = 1
		reset_state(player, 1)
		player_move()
	end

end

function player_move()


	if (player.facing == -1 and btn(0)) or (player.facing == 1 and btn(1)) then	-- Checks if button pushed in direction of travel
		if (player.momentx == 0) player.momentx += (0.2*player.facing)	-- Gives a little boost when starting off
		player.momentx += (0.5*player.facing)	-- Accelerates
	else
		if abs(player.momentx) < 0.6 then		-- If within 0.6 of stopping, stops
			player.momentx = 0
			player.state = 0
		else									-- Else: slows down
			player.momentx -= (0.5*player.facing)
			player.state = 1					-- (function player_slow moved here) 
		end							
	end

	if (btn(0)) player.facing = -1
	if (btn(1)) player.facing = 1

	if player.animcount < 4 then	-- checks ticks elapsed for frame
		player.animcount += 1

	else

		player.animcount = 0

		if player.frame == 2 then	-- oscillates back and forth over 2, between 1 and 3 inclusive
			player.frame += player.animswitch
		else
			player.animswitch = player.animswitch * -1
			player.frame += player.animswitch
		end

	end

	if btnp(2) then			-- Check if jump hit to exit state
		player.cely -= 1		-- Change cely to check collision
		player.momenty = -3.3		-- Change momentum to check collision
		if (check_collision(player, 'y')%2) == 1 then		-- If player collides, set back to idle (before changing frames), and reset momenty
			player.state = 1
			player.momenty = 0
		else
			reset_state(player, 2)		-- Else: Player has headroom, change state to jumping
		end								-- NB: This all needs doing out of order to avoid drawing while in state 2
	end

end


function player_jump()

	if player.momenty < -0.5 then
		player.frame = 1
	elseif player.momenty < 0.5 then
		player.frame = 2
	else
		player.frame = 3
	end

	if abs(player.momentx) < 2 then
		if (btn(0)) player.momentx -= 0.1
		if (btn(1)) player.momentx += 0.1
		if (abs(player.momentx) > 0.2) player.facing = player.momentx / abs(player.momentx) -- cunning code: returns -1 if momentx negative, 1 if positive.
	end

end

function player_mantle()

	if abs(player.animswitch) == 1 then

		player.scrxpos = player.celx*8
		player.scrypos = player.cely*8

		if btn(3) then
			reset_state(player, 2)
			player.momenty = -0.2
		end

		if (player.facing == -1 and btn(1)) or (player.facing == 1 and btn(0)) then -- Drop if player pressed away from ledge
			player.facing *= -1
			reset_state(player, 2)
			player.momentx += 0.4 * player.facing
			player.momenty = -0.2
		elseif btnp(2) then
			player.animcount = 0
			player.animswitch = 2	-- If Jump pressed, break breathing animation cycle
		end
	
		player.animcount += 1	-- Roll on animation count

		if player.animcount > 8 then	-- Check if animation cycle ended
			player.animcount = 0	-- Reset animation count, 
			player.frame += player.animswitch	--Add animswitch to frame
			player.animswitch *= -1		-- Flip animswitch - flip-flops between frames
		end

	else

		player.frame = 3

		if player.animcount == 4 then	-- Player spends 4 ticks on jumping frame, then jumps
			
			reset_state(player, 2)
			player.momentx = 1*player.facing
			player.momenty = -3.3

		else

			player.animcount += 1
		
		end

	end

end