-- tab 2: move entities

function move_entities()

    player.momenty += 0.3
    if (player.momenty > 4.0) player.momenty = 4.0

    if (abs(player.momentx) > 2) player.momentx = 2*player.facing

    player.celx = flr((player.scrxpos+player.momentx+4)/8)
    player.cely = flr((player.scrypos+player.momenty)/8)

    collide_value = check_collision(player, 'y')    -- Check_collision returns bitfield, collide_value avoids calling the function over and over
    
    if player.state != 3 then                   -- Don't do collision check if player mantling
        if (collide_value%2) == 1 then          -- Cunning code: Checks if flag bitfield is even - only odd if flag 0 in field
            if player.momentx != 0 then          -- Important: check if player has x momentum; if so, running.
                player.state = 1                -- Don't use reset_state, to preserve frame
            else
                player.state = 0
            end
            if player.momenty < 0 then
                player.scrypos = 8*(player.cely+1)
            else
                player.scrypos = 8*player.cely
            end
            player.momenty = 0
        else
            player.scrypos += player.momenty
            player.state = 2
        end
    end
                                                        -- NB for x collision: tracks one cel in front of player, by facing
    if player.state == 1 or player.state == 2 then      -- If player moving or jumping
        
        collide, mantle = check_collision(player, 'x')

        if collide == true then      -- Check if player should be colliding
            player.momentx = 0
            player.scrxpos = 8*(player.celx)
        else
            player.scrxpos += player.momentx
        end

        if player.state == 2 and mantle == true and (btn(0) or btn(1)) then     -- Check if player should be mantling
            reset_state(player, 3)
            player.animswitch = -1
            player.momenty = 0
            player.scrypos = 8*player.cely
        end

    end


end
